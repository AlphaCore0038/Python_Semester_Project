# AI Digital Locker — FastAPI backend environment template
# Copy to backend/.env and fill in real values. NEVER commit backend/.env.

# --- Supabase (server-only privileged credentials) ---
# Project Settings -> API in the Supabase dashboard
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Sessions (server-side) ---
# Opaque session tokens are stored as SHA-256 hashes in Supabase.
# Session lifetime in minutes (default 24h)
SESSION_EXPIRY_MINUTES=1440

# --- Single administrator ---
# The account with this email is eligible for explicit promotion. It must be
# registered first; then run once from backend/ (never automatically):
#   .venv\Scripts\python.exe scripts\make_admin.py
ADMIN_EMAIL=admin@example.com

# --- OpenRouter cloud AI (server-only; the only working AI option) ---
OPENROUTER_API_KEY=your-openrouter-api-key
# MiniMax M3.1 Flash via OpenRouter's free route. There is NO fallback model:
# if the free route is busy or unavailable, AI endpoints return a clear 503
# and the locker keeps working without the assistant.
OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free
# Always-on reasoning effort: low | medium | high (low keeps chat latency sane)
OPENROUTER_REASONING_EFFORT=low

# --- Storage limits ---
# Per-user cloud storage quota: 500 MB (application-level; spec requirement)
STORAGE_QUOTA_BYTES=524288000
# Per-file upload cap: 50 MB, matching the Supabase Free-plan maximum object size
MAX_UPLOAD_BYTES=52428800

# --- Google Sheets admin registry (deferred to a later phase) ---
# GOOGLE_SHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json
