# Django web client environment template
#
# Copy to web/.env (never commit real .env files).
# FastAPI/Supabase secrets never live here - Django only needs these values.

# Base URL of the FastAPI backend
FASTAPI_BASE_URL=http://127.0.0.1:8000

# Required. Generate one with:
#   py -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# True for local development, False in production.
DEBUG=True

# Optional. Defaults to the inverse of DEBUG, so production keeps Secure
# cookies on. Set False only for local HTTP runs with DEBUG=False.
# COOKIE_SECURE=False
