# AI Digital Locker — root environment template
#
# Copy values into the appropriate real .env file (never commit real .env files).
# Backend secrets live in backend/.env — see backend/.env.example.
# This root template only holds non-secret client configuration.

# Base URL of the FastAPI backend, used by the Django web client and Tkinter desktop client
FASTAPI_BASE_URL=http://127.0.0.1:8000
